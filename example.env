# ==============================================================================
# CodeGate Environment Configuration (Optional)
# ==============================================================================
# NOTE: CodeGate works 100% out-of-the-box offline with zero configuration!
# All values below are optional. Copy this file to .env to customize behavior.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Quiz Evaluator (Optional)
# ------------------------------------------------------------------------------
# By default, CodeGate uses an offline deterministic AST/diff quiz generator.
# If you want to enable deeper conceptual questions via an LLM judge, provide
# an API key below:
# CODEGATE_LLM_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 2. Capability Token TTL (Optional)
# ------------------------------------------------------------------------------
# Duration (in seconds) that an approved quiz capability token remains valid
# before expiring. Default: 1800 (30 minutes).
CODEGATE_TOKEN_TTL=1800

# ------------------------------------------------------------------------------
# 3. Quiz Passing Score Threshold (Optional)
# ------------------------------------------------------------------------------
# Passing threshold between 0.0 and 1.0.
# 1.0 requires 100% correct answers to unlock git commit.
# Default: 1.0
CODEGATE_PASSING_SCORE=1.0
