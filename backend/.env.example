# SAP Connectivity Engine - Example Configuration

# Set MOCK=true for simulated demo / walkthrough mode without real SAP systems
MOCK=true
PORT=8080
NODE_ENV=development

# --- Mode A: ARC1 MCP Server on SAP BTP (Recommended) ---
# ARC1_SERVER_URL=https://your-arc1-mcp-server.cfapps.eu10.hana.ondemand.com
# ARC1_API_KEY=your-api-key
# ARC1_CLIENT_ID=your-xsuaa-client-id
# ARC1_CLIENT_SECRET=your-xsuaa-client-secret
# ARC1_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token

# --- Mode B: Direct node-rfc (Legacy) ---
# RFC_USER=SAP_RFC_USER
# RFC_PASSWD=SecretPassword
# RFC_CLIENT=100
# RFC_ASHOST=172.17.19.18
# RFC_SYSNR=00
# RFC_LANG=EN

# --- SAP Cloud Connector (SCC) Local REST API ---
# SCC_HOST=localhost
# SCC_PORT=8443
# SCC_ADMIN_USER=Administrator
# SCC_ADMIN_PASSWORD=manage

# --- Mode C: AWS Site-to-Site IPSec VPN Tunnel Automation ---
# PROVISIONING_MODE: 'mock' (default, simulated demo) or 'cloudformation' (real AWS)
PROVISIONING_MODE=mock
AWS_REGION=us-east-1
AWS_CONFIGURATION_BUCKET=ktern-connectivity-configs
AWS_CLOUDFORMATION_TEMPLATE_KEY=cloudformation/templates/ipsec-tunnel-template.yaml
AWS_STACK_PREFIX=ipsec
# AWS_CFN_SERVICE_ROLE_ARN=arn:aws:iam::123456789012:role/ipsec-cfn-service-role
# AWS_TARGET_VPC_ID=vpc-0123456789abcdef0
# AWS_TARGET_VGW_ID=vgw-0123456789abcdef0
# AWS_TARGET_ROUTE_TABLE_IDS=rtb-0123456789abcdef0
